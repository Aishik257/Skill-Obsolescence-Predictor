# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillpulse

# --- API ---
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=20
MODEL_DIR=./app/ml/models
LOG_LEVEL=INFO

# --- Optional LLM enhancement (app works fully with these empty) ---
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# --- NLP: auto | tfidf | sentence-transformers ---
EMBEDDING_BACKEND=auto

# --- Docker: seed sample data on first start ---
AUTO_SEED=false
